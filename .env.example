# ─── Banco de Dados ──────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=aditiva_pronto
DB_USER=root
DB_PASS=senha_segura

# ─── Servidor Backend ─────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Frontend (em produção o backend serve o build) ───────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── Caminhos de arquivo ──────────────────────────────────────────────────────
# Pasta onde ficam os exports do Domínio Registro
EXPORTS_FOLDER=N:\KAUAN\AditivaPronto\Exports

# Caminho do template .docx (copie o arquivo para cá)
TEMPLATE_PATH=N:\KAUAN\AditivaPronto\Model\Template Termo Aditivo.docx

# Pasta onde os documentos gerados serão salvos
GENERATED_FOLDER=./generated

# ─── Upload ───────────────────────────────────────────────────────────────────
UPLOAD_MAX_MB=20
