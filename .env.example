# ─── Banco de Dados ───────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=aditiva_pronto
DB_USER=root
DB_PASS=senha_segura
DB_ROOT_PASSWORD=root_senha_segura

# ─── Servidor Backend ─────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Pastas de arquivo ────────────────────────────────────────────────────────
# IMPORT_FOLDER: pasta onde ficam os relatórios xlsx exportados do Domínio Registro
# Em desenvolvimento local (Windows): use caminho absoluto
# Em produção Docker: use /app/imports (pasta montada via volume)
IMPORT_FOLDER=./imports

# Pasta onde os documentos DOCX gerados serão salvos
GENERATED_DIR=./generated

# Caminho do template .docx (copie seu arquivo Word para cá)
TEMPLATE_PATH=./templates/termo_aditivo.docx
