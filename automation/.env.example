# Caminho completo para o executável do Domínio Registro
DOMINIO_EXE_PATH=C:\Dominio\Registro\DominioRegistro.exe

# Pasta onde os relatórios exportados serão salvos
EXPORT_FOLDER=C:\Relatorios\DominioRegistro

# Credenciais de login (se necessário)
DOMINIO_USER=admin
DOMINIO_PASS=

# Timeouts em milissegundos
TIMEOUT_APP_LOAD=30000
TIMEOUT_MENU_OPEN=5000
TIMEOUT_REPORT_GENERATE=60000
TIMEOUT_EXPORT=30000

# Tentativas de retry
MAX_RETRIES=3
RETRY_DELAY_MS=2000

# Modo debug (true = mais logs e screenshots em cada etapa)
DEBUG_MODE=false
